{
  "name": "enterprise-expo-monorepo-blueprint",
  "private": true,
  "scripts": {
    "start": "turbo run start",
    "android": "turbo run android",
    "ios": "turbo run ios",
    "web": "turbo run web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "start:app-one": "turbo run start --filter=app-one",
    "android:app-one": "turbo run android --filter=app-one",
    "ios:app-one": "turbo run ios --filter=app-one",
    "web:app-one": "turbo run web --filter=app-one",
    "build:app-one": "turbo run build --filter=app-one",
    "lint:app-one": "turbo run lint --filter=app-one",
    "typecheck:app-one": "turbo run typecheck --filter=app-one",
    "test:app-one": "turbo run test --filter=app-one"
  },
  "devDependencies": {
    "@workspace/config": "workspace:*",
    "prettier": "^3.7.4",
    "turbo": "^2.10.11",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.19.0"
  }
}
